#!/bin/bash
# Launcher for BrainOut.app (Contents/MacOS/BrainOut).
# The game reads and writes files relative to its working directory
# (settings.json, error.log, cache/, packages/), so it runs from a folder in
# ~/Library/Application Support instead of from inside the read-only bundle.

CONTENTS="$(cd "$(dirname "$0")/.." && pwd)"
RES="$CONTENTS/Resources"
DATA="$HOME/Library/Application Support/BrainOut"

GAME="$DATA/game"

mkdir -p "$DATA"
cd "$DATA" || exit 1

# The game files (jar and data packages) are copied out of the bundle, to a folder the in-game
# updates can write to: macOS may run a downloaded app from a read-only location. They are
# copied again whenever the app itself is replaced by another build.
if [ ! -f "$GAME/brainout-desktop.jar" ] || ! cmp -s "$RES/game/stamp" "$GAME/.stamp"; then
    rm -rf "$GAME.new"
    if ditto "$RES/game" "$GAME.new"; then
        rm -rf "$GAME" && mv "$GAME.new" "$GAME" && cp "$RES/game/stamp" "$GAME/.stamp"
    fi
fi

# the game looks for packages/ in its working directory
if [ -e packages ] && [ ! -L packages ]; then
    mv packages "packages.old.$(date +%s)"
fi
ln -sfn "game/packages" packages

# Extra arguments can be put in ~/Library/Application Support/BrainOut/args.txt
# (one per line), e.g. "--connect brainout://..." to skip the IP prompt.
EXTRA_ARGS=()
if [ -f args.txt ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        [ -n "$line" ] && EXTRA_ARGS+=("$line")
    done < args.txt
fi

exec "$RES/runtime/bin/java" \
    -XstartOnFirstThread \
    -Xmx2g \
    -Dapple.awt.application.name=BrainOut \
    -Dbrainout.app="$(dirname "$CONTENTS")" \
    --add-opens java.base/java.lang=ALL-UNNAMED \
    --add-opens java.base/java.lang.reflect=ALL-UNNAMED \
    --add-opens java.base/java.util=ALL-UNNAMED \
    --add-opens java.base/java.nio=ALL-UNNAMED \
    --add-opens java.base/sun.nio.ch=ALL-UNNAMED \
    --add-opens java.base/java.net=ALL-UNNAMED \
    -jar "$GAME/brainout-desktop.jar" \
    --offline --unsafe \
    "${EXTRA_ARGS[@]}" "$@" \
    >> "$DATA/launcher.log" 2>&1
